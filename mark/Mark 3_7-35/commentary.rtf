\pard\tx220\tx720\pardeftab720\li720\fi-720\sa80\pardirnatural\partightenfactor0
\ls1\ilvl0
\f1\b0\fs23 \cf0 {\listtext	\uc0\u8226 	}Mark 3:7-12 | Crowds Press In and Impure Spirits Know Him\
{\listtext	\uc0\u8226 	}Mark 3:13-19 | Jesus Appoints the Twelve\
{\listtext	\uc0\u8226 	}Mark 3:20-21 | Jesus' Family Misunderstands Him\
{\listtext	\uc0\u8226 	}Mark 3:22-30 | Jesus Answers the Beelzebul Charge\
